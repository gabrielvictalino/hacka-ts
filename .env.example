# Copie com: python3 scripts/init_env.py
POSTGRES_DB=ipbot
POSTGRES_USER=ipbot
POSTGRES_PASSWORD=
AUTH_SECRET=
AUTH_DEMO_ENABLED=true
# Contas fictícias do simulador; substitua somente no .env local.
AUTH_DEMO_USERS={"empregado":{"name":"Pessoa empregada","role":"empregado"},"gestor":{"name":"Pessoa gestora","role":"gestor"},"gestao":{"name":"Gestão do acervo","role":"gestao"}}
FRONTEND_PORT=5173
API_PORT=8000
# Pasta local com ferias/, inovacao/ e locacao/; usada pelo serviço importer.
COLLECTION_PATH=./acervo
