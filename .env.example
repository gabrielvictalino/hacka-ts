# Copie com: python3 scripts/init_env.py
POSTGRES_DB=ipbot
POSTGRES_USER=ipbot
POSTGRES_PASSWORD=
AUTH_SECRET=
AUTH_DEMO_ENABLED=true
AUTH_DEMO_SSO_SECRET=
AUTH_DEMO_USERS={}
# HTTP local do Compose. Em HTTPS, configure true.
AUTH_COOKIE_SECURE=false
FRONTEND_PORT=5173
API_PORT=8000
# Pasta local com ferias/, inovacao/ e locacao/; usada pelo serviço importer.
COLLECTION_PATH=./acervo
